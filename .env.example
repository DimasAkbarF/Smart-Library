# ==============================================================================
# SMART LIBRARY ENVIRONMENT CONFIGURATION
# SMP Negeri 17 Tangerang Selatan
# ==============================================================================

# 1. Supabase (Database & Authentication)
# Diperoleh dari Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# Service role key HANYA untuk server (Server Actions, Seeder, Admin API). JANGAN pasang prefix NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# 2. Base URL Aplikasi
# Diperoleh dari domain resmi produksi aplikasi
NEXT_PUBLIC_APP_URL=https://perpustakaansmp17tangsel.web.id

# 3. Cloudflare Turnstile (Anti-Bot Protection)
# Diperoleh dari Cloudflare Dashboard -> Turnstile -> Add Site
# Di lingkungan produksi (Production Deployment):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFVX0fDi98H2T4Cy
# Secret key HANYA untuk server (actions). JANGAN pasang prefix NEXT_PUBLIC_!
TURNSTILE_SECRET_KEY=0x4AAAAAAFVX0RT5U82CYCbeFAXNS1sK8kA

# Catatan Pengujian Lokal (Development / Localhost):
# Jika menguji secara offline di localhost, Anda dapat menggunakan dummy test key resmi Cloudflare:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
