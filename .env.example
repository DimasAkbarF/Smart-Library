# Supabase — isi dari project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-key
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-service-role-key
# Hanya dipakai server (actions, seed). JANGAN beri prefix NEXT_PUBLIC.

# URL publik aplikasi (untuk payload QR deep-link, opsional)
NEXT_PUBLIC_APP_URL=http://localhost:3000
