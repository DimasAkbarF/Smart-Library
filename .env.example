# Supabase — isi dari project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Hanya dipakai server (actions, seed). JANGAN beri prefix NEXT_PUBLIC.

# URL publik aplikasi (untuk payload QR deep-link, opsional)
NEXT_PUBLIC_APP_URL=https://perpustakaansmp17tangsel.web.id
# Cloudflare Turnstile (Anti-Bot)
# Dapatkan dari Cloudflare Dashboard -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key HANYA di server (actions). JANGAN beri prefix NEXT_PUBLIC!
TURNSTILE_SECRET_KEY=
